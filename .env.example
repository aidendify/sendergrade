# --- Required ---
SECRET_KEY=change-me-to-a-long-random-string
OWNER_PASSWORD=change-me
AGENCY_NAME=Your Agency
PUBLIC_BASE_URL=http://127.0.0.1:8080

# --- Server (Compose sets these; leave as-is) ---
PORT=8080
DATABASE_PATH=/data/sendergrade.db

# --- Branding for /check, /r/{token} reports and emails (optional) ---
AGENCY_LOGO_URL=
AGENCY_ACCENT_COLOR=#1d4e89
AGENCY_CTA_TEXT=Want us to fix this? Book a call
AGENCY_CTA_URL=

# --- Public "check your domain" page ---
PUBLIC_CHECK_ENABLED=true
PUBLIC_CHECK_RATE_PER_HOUR=10
# Optional global cap across all visitors (default 200 per hour)
PUBLIC_CHECK_GLOBAL_PER_HOUR=200
# Set true ONLY when a reverse proxy (Caddy/nginx) sits in front, so per-IP limits see the real visitor IP
TRUST_PROXY_HEADERS=false

# --- Checks ---
CHECK_HOUR_UTC=3
# Optional resolver IP(s), comma-separated, e.g. 1.1.1.1. Blank = system resolver.
DNS_RESOLVER=
DNS_TIMEOUT_SECONDS=3

# --- Optional SMTP for change alerts + new-lead notifications ---
ALERT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# --- Optional "Powered by" footer. Leave empty for no footer. ---
MARKETING_URL=
